{
  "name": "kindling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run lint:copy && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-demo": "node -e \"console.log('db:seed-demo: not yet')\"",
    "qloo:spike": "node -e \"console.log('qloo:spike: not yet')\"",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "db:smoke": "tsx --env-file=.env.local --tsconfig tsconfig.json scripts/db-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.138",
    "@ai-sdk/groq": "^3.0.79",
    "ai": "^6.0.315",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "description": "An AI agent that turns a venue's empty weeknight into a recurring club, powered by the Qloo taste API.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  }
}
