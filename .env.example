# Copy to .env.local and fill in. Never commit .env.local.

# --- Qloo ---
# The hackathon key only works on the hackathon host.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# fixtures = offline sample data (dev/tests), live = real API, record = live + save raw JSON to the git-ignored fixtures/live/ (local only, never in production)
QLOO_MODE=fixtures

# --- LLM (Vercel AI SDK, free tiers first) ---
# mock = canned outputs, no key needed (use for tests and early dev). live = real calls.
LLM_MODE=mock
# Main provider: google (Gemini) | groq | openai-compatible (OpenRouter)
LLM_PROVIDER=google
# Fallbacks, tried in order when the main provider fails or is rate limited. Comma separated.
LLM_FALLBACK_PROVIDERS=openai-compatible

# Main provider models. LLM_MODEL is used by the Designer, Producer and Coach; LLM_MODEL_FAST by the Scout and Baseline.
# Checked against the live API on 2026-10-27 (Gemini 2.5 models are closed to new keys; the 3.x "-latest" aliases were overloaded).
# gemini-3.5-flash-lite gave the steadiest times: about 1.7 s for a structured answer and 1.5 to 8 s for a Scout planning step.
LLM_MODEL=gemini-3.5-flash
LLM_MODEL_FAST=gemini-3.5-flash-lite
# How long Gemini 3 models may think before answering: minimal | low | medium | high. Uncapped they took up to 34 s.
LLM_THINKING_MAIN=minimal
LLM_THINKING_FAST=minimal
GOOGLE_GENERATIVE_AI_API_KEY=

# Fallback models. Each fallback needs <PROVIDER>_MODEL and <PROVIDER>_MODEL_FAST, or it is skipped.
# Groq free tier (check https://console.groq.com/docs/models for the current list).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
# OpenRouter as the OpenAI-compatible endpoint. openrouter/free picks a working free model for each request, which is
# steadier than naming one (individual :free models are often rate limited upstream).
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=openrouter/free
OPENAI_COMPATIBLE_MODEL_FAST=openrouter/free

# --- Database (Neon Postgres) ---
# Neon dashboard > your project > Connect > copy the pooled connection string
DATABASE_URL=

# --- App ---
APP_URL=http://localhost:3000
RATE_LIMIT_PER_HOUR=10
# Identifying User-Agent for Nominatim (app name + repo URL, no personal email)
NOMINATIM_USER_AGENT=kindling-hackathon/0.1 (+https://github.com/YOUR_GITHUB/kindling)
