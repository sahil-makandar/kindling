# Copy to .env.local and fill in. Never commit .env.local.

# --- Qloo ---
# The hackathon key only works on the hackathon host.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# fixtures = offline sample data (dev/tests), live = real API, record = live + save raw JSON to fixtures/live/
QLOO_MODE=fixtures

# --- LLM (Vercel AI SDK, free tier first) ---
# mock = canned outputs, no key needed (use for tests and early dev). live = real calls.
LLM_MODE=mock
# google (Gemini) | groq | xai (Grok) | openai-compatible (e.g. MiniMax) | anthropic (paid, optional)
LLM_PROVIDER=google
# Optional: tried once if the main provider fails or is rate-limited
LLM_FALLBACK_PROVIDER=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
# Set these to the current free models shown in your provider's console
LLM_MODEL=
LLM_MODEL_FAST=

# --- Database (Neon Postgres) ---
# Neon dashboard > your project > Connect > copy the pooled connection string
DATABASE_URL=

# --- App ---
APP_URL=http://localhost:3000
RATE_LIMIT_PER_HOUR=10
# Identifying User-Agent for Nominatim (app name + repo URL, no personal email)
NOMINATIM_USER_AGENT=kindling-hackathon/0.1 (+https://github.com/YOUR_GITHUB/kindling)
